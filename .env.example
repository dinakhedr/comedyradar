# Copy to .env.local for local development (never commit .env.local).
# Add the same names in Vercel → Settings → Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# The live site address, e.g. https://comedyradarnetwork.vercel.app
NEXT_PUBLIC_SITE_URL=
# Google Analytics 4 Measurement ID (G-…). Leave empty to turn analytics and the cookie banner off.
NEXT_PUBLIC_GA_ID=
